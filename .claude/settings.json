{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git -C * commit *)",
      "Bash(git -C * push *)",
      "Bash(git reset *)",
      "Bash(git rebase *)",
      "Bash(git clean *)",
      "Bash(git restore *)",
      "Bash(git checkout -- *)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "Bash(git tag *)",
      "Bash(git stash drop *)",
      "Bash(git stash clear *)",
      "Bash(git config *)",
      "Bash(gh *)",
      "Bash(rm *)",
      "Bash(arduino-cli upload *)",
      "Bash(arduino-cli compile *--upload*)",
      "Bash(arduino-cli compile * -u *)",
      "Bash(esptool *)",
      "Bash(esptool.py *)",
      "Bash(python3 -m esptool *)",
      "Bash(bossac *)",
      "Bash(nc *)",
      "Bash(ncat *)",
      "Bash(socat *)",
      "Bash(ros2 topic pub *)",
      "Bash(ros2 run *)",
      "Bash(ros2 launch *)"
