      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git * --no-verify*)",
      "Bash(git filter-branch *)",
      "Bash(git filter-repo *)",
      "Bash(git remote add *)",
      "Bash(git remote set-url *)",
      "Bash(git remote remove *)",
      "Bash(git remote rm *)",
      "Bash(sudo *)",
      "Read(**/secrets.h)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/secrets.h)",
      "Edit(**/.env)",
      "Edit(**/.env.*)"
    ]
  }
}
